                "name": "last",
                "value": "",
                "type": "query",
                "description": "The number of elements to retrieve before the 'before' cursor location"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "The starting cursor to begin searching, defaults to the end of the list"
              }
