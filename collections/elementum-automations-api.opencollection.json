{
  "opencollection": "1.0.0",
  "info": {
    "name": "Elementum Access Token Automations API",
    "version": "0.0.1"
  },
  "items": [
    {
      "info": {
        "name": "Automations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List automations under an app or element",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/:recordType/:alias/automations",
            "params": [
              {
                "name": "recordType",
                "value": "",
                "type": "path",
                "description": "'apps', 'elements', 'tasks', or 'transactions'"
              },
              {
                "name": "alias",
                "value": "",
                "type": "path",
                "description": "The app's namespace or its UUID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List automations under an app or element"
        },
