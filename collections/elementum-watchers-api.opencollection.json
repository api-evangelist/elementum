{
  "opencollection": "1.0.0",
  "info": {
    "name": "Elementum Access Token Watchers API",
    "version": "0.0.1"
  },
  "items": [
    {
      "info": {
        "name": "Watchers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the list of watchers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/:recordType/:alias/:id/watchers",
            "params": [
              {
                "name": "recordType",
                "value": "",
                "type": "path",
                "description": "'apps', 'elements', 'tasks', or 'transactions'"
              },
              {
                "name": "alias",
                "value": "",
                "type": "path",
                "description": "The app's namespace or its UUID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The record ID"
              },
              {
                "name": "first",
                "value": "",
                "type": "query",
                "description": "The number of elements to retrieve after the 'after' cursor location"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "The starting cursor to begin searching, defaults to the beginning of the list"
              },
              {
                "name": "last",
                "value": "",
                "type": "query",
                "description": "The number of elements to retrieve before the 'before' cursor location"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "The starting cursor to begin searching, defaults to the end of the list"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get the list of watchers"
        },
        {
          "info": {
            "name": "Add a watcher",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/:recordType/:alias/:id/watchers",
            "params": [
              {
                "name": "recordType",
                "value": "",
                "type": "path",
                "description": "'apps', 'elements', 'tasks', or 'transactions'"
              },
              {
                "name": "alias",
                "value": "",
                "type": "path",
                "description": "The app's namespace or its UUID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The record ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Add a watcher"
        },
        {
          "info": {
            "name": "Delete a watcher",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/v1/:recordType/:alias/:id/watchers",
            "params": [
              {
                "name": "recordType",
                "value": "",
                "type": "path",
                "description": "'apps', 'elements', 'tasks', or 'transactions'"
              },
              {
                "name": "alias",
                "value": "",
                "type": "path",
                "description": "The app's namespace or its UUID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The record ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Delete a watcher"
        }
      ]
    }
  ],
  "bundled": true
}